diff --git a/data/org.gnome.gedit.desktop.in b/data/org.gnome.gedit.desktop.in
index ccc846a..51fc0ce 100644
--- a/data/org.gnome.gedit.desktop.in
+++ b/data/org.gnome.gedit.desktop.in
@@ -1,12 +1,12 @@
 [Desktop Entry]
-Name=gedit
+Name=gedit+
 Comment=Edit text files
 Exec=gedit %U
 Terminal=false
 Type=Application
 StartupNotify=true
 MimeType=text/plain;application/x-zerosize;
-Icon=org.gnome.gedit
+Icon=org.gnome.gedit-drafts
 Categories=GNOME;GTK;Utility;TextEditor;
 Actions=new-window;new-document;
 # Translators: Do NOT translate or localize the semicolons. The list MUST also
diff --git a/data/org.gnome.gedit.gschema.xml.in b/data/org.gnome.gedit.gschema.xml.in
index 21cae95..222ed95 100644
--- a/data/org.gnome.gedit.gschema.xml.in
+++ b/data/org.gnome.gedit.gschema.xml.in
@@ -326,4 +326,11 @@
       <description>List of active plugins.</description>
     </key>
   </schema>
+  <schema id="org.gnome.gedit.preferences.drafts" path="/org/gnome/gedit/preferences/drafts/">
+    <key name="preserve-on-close" type="b">
+      <default>true</default>
+      <summary>Preserve untitled documents when closing</summary>
+      <description>Store untitled documents automatically when closing a window or quitting. When disabled, use the normal Save, Discard, or Cancel confirmation. Previously stored drafts still reopen.</description>
+    </key>
+  </schema>
 </schemalist>
diff --git a/gedit/gedit-app.c b/gedit/gedit-app.c
index 18208ac..b41a403 100644
--- a/gedit/gedit-app.c
+++ b/gedit/gedit-app.c
@@ -20,6 +20,7 @@
 #include "config.h"
 
 #include "gedit-app.h"
+#include "gedit-drafts.h"
 #include "gedit-app-private.h"
 
 #include <string.h>
@@ -363,7 +364,8 @@ open_files (GApplication            *application,
 		g_slist_free (loaded);
 	}
 
-	if (!doc_created || new_document)
+	if ((!doc_created && !(g_object_get_data (G_OBJECT (window), "draft-path") &&
+	                      gedit_window_get_active_tab (window) != NULL)) || new_document)
 	{
 		gedit_debug_message (DEBUG_APP, "Create tab");
 		tab = gedit_window_create_tab (window, TRUE);
@@ -405,6 +407,8 @@ new_document_activated (GSimpleAction *action,
 {
 	GApplication *application = G_APPLICATION (user_data);
 
+	gedit_drafts_restore (GEDIT_APP (application));
+
 	open_files (application,
 	            FALSE,
 	            TRUE,
@@ -796,6 +800,8 @@ gedit_app_activate (GApplication *application)
 
 	priv = gedit_app_get_instance_private (GEDIT_APP (application));
 
+	gedit_drafts_restore (GEDIT_APP (application));
+
 	open_files (application,
 	            priv->new_window,
 	            priv->new_document,
@@ -1007,6 +1013,8 @@ gedit_app_open (GApplication  *application,
 
 	file_list = g_slist_reverse (file_list);
 
+	gedit_drafts_restore (GEDIT_APP (application));
+
 	open_files (application,
 	            FALSE,
 	            FALSE,
@@ -1296,8 +1304,8 @@ gedit_app_init (GeditApp *app)
 {
 	TeplApplication *tepl_app;
 
-	g_set_application_name ("gedit");
-	gtk_window_set_default_icon_name ("org.gnome.gedit");
+	g_set_application_name ("gedit+");
+	gtk_window_set_default_icon_name ("org.gnome.gedit-drafts");
 
 	g_application_add_main_option_entries (G_APPLICATION (app), option_entries);
 
diff --git a/gedit/gedit-commands-file.c b/gedit/gedit-commands-file.c
index 91e0923..9784f16 100644
--- a/gedit/gedit-commands-file.c
+++ b/gedit/gedit-commands-file.c
@@ -21,6 +21,7 @@
  */
 
 #include "gedit-commands.h"
+#include "gedit-drafts.h"
 #include "gedit-commands-private.h"
 
 #include <glib/gi18n.h>
@@ -1714,7 +1715,10 @@ save_and_close_documents (GList         *docs,
 			}
 			else
 			{
-				/* The document can be closed without saving */
+				/* Remove discarded drafts when using normal confirmation. */
+				if (!GPOINTER_TO_BOOLEAN (g_object_get_data (G_OBJECT (window), "draft-preserve-close")) &&
+				    !gedit_drafts_forget (doc, window))
+					continue;
