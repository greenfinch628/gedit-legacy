#!/usr/bin/make -f
export DEB_BUILD_MAINT_OPTIONS = hardening=+all
%:
	dh $@
override_dh_auto_configure:
	true
override_dh_auto_build:
	packaging/build-payload.sh build
override_dh_auto_test:
	packaging/build-payload.sh check
override_dh_auto_install:
	packaging/build-payload.sh install debian/gedit-plus
override_dh_auto_clean:
	rm -rf build-tepl build-gedit build-pc stage-deps
override_dh_shlibdeps:
	dh_shlibdeps -- -ldebian/gedit-plus/opt/gedit-plus/lib -ldebian/gedit-plus/opt/gedit-plus/lib/gedit
